// App code: Nuxt's generated config (aliases, #imports / #components, strict) minus the tests.
{
  "extends": "./.nuxt/tsconfig.app.json",
  "exclude": [
    "node_modules",
    "node_modules/nuxt/node_modules",
    "node_modules/@pinia/nuxt/node_modules",
    ".output",
    ".data",
    "src/**/__tests__/**"
  ],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  }
}
