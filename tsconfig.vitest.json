// Component tests run on plain Vue in jsdom; they see the same app types plus Vitest's.
{
  "extends": "./tsconfig.app.json",
  "include": ["./.nuxt/nuxt.d.ts", "src/**/__tests__/**/*", "src/svg-component.d.ts"],
  "exclude": [],
  "compilerOptions": {
    "types": ["node", "jsdom"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo"
  }
}
